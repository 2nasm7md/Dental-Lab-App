# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_LOCALE=ar
PENDING_TIMEOUT_HOURS=48

# When true, server pages render caught errors inline instead of throwing
# to the route error boundary. Useful for diagnosing prod-only issues
# without enabling full source maps. Remove once a session is debugged.
NEXT_PUBLIC_DEBUG=false
